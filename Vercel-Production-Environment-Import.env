# 赴港通：Vercel Production 环境变量导入清单
# 使用方式：将下面内容整体粘贴到 Vercel 的 Environment Variables 导入界面。
# 先替换所有 REPLACE_WITH_... 占位符，再导入；不要将填好密钥的此文件提交到 Git。

# 应用与登录
AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
DEMO_CODE=888888
CROSS_BORDER_ENABLED=true

# LinkAI：当前生产工作流
AI_PROVIDER=linkai
LINKAI_API_URL=https://api.link-ai.tech/v1/workflow/run
LINKAI_APP_CODE=anUstB6KwN
LINKAI_API_KEY=REPLACE_WITH_LATEST_LINKAI_API_KEY

# 飞书应用：填写当前飞书应用的凭证
FEISHU_APP_ID=REPLACE_WITH_FEISHU_APP_ID
FEISHU_APP_SECRET=REPLACE_WITH_FEISHU_APP_SECRET
FEISHU_APP_TOKEN=KyoPbl9APaiZ8CsOpipcpEDtnxf

# 飞书数据表：如新表 ID 与此处不同，请替换为新表 ID
FEISHU_CUSTOMER_TABLE_ID=tbliZtofcDldahb0
FEISHU_PRE_HK_TABLE_ID=tblqO9yIXbdy4tB9
FEISHU_IN_HK_TABLE_ID=REPLACE_WITH_IN_HK_TABLE_ID_OR_REMOVE_IF_UNUSED
FEISHU_PROVIDER_RECOMMENDATION_TABLE_ID=tblplhRgvn59uhYa
